.DS_Store

# Lokale Referenzquellen von Governikus (EUPL 1.2), nicht Teil des Plugins.
# Der Code der Wrapper darf nicht ins Plugin übertragen werden.
/AusweisApp-SDK-Wrapper-main/
/AusweisApp2Wrapper-iOS-SPM-main/

# Vom SDK-Quellbaum bleibt nur die Protokoll-Doku samt Lizenztexten sichtbar.
/AusweisApp-community/*
!/AusweisApp-community/LICENSE.txt
!/AusweisApp-community/LICENSE.officially.txt
!/AusweisApp-community/docs/
/AusweisApp-community/docs/*
!/AusweisApp-community/docs/sdk/
# docs/sdk/failurecodes.rst bindet nur diese Datei ein; sie ist die Quelle der
# Fehlerklassen (lib/src/failure.dart) und wird von test/failure_test.dart gelesen.
!/AusweisApp-community/docs/failurecodes/
/AusweisApp-community/docs/failurecodes/*
!/AusweisApp-community/docs/failurecodes/failurecodes.rst

# Dart / Flutter
.dart_tool/
build/
/pubspec.lock
.flutter-plugins-dependencies
.idea/
*.iml
